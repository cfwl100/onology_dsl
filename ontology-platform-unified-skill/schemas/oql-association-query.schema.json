{
  "title": "OQL ASSOCIATION_QUERY JSON Schema",
  "description": "对象关系/路径关联查询；支持一跳/多跳关系明细查询，以及关系路径上的 GROUP_BY + METRIC 聚合查询。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "schemaRef",
    "operation",
    "objects",
    "relationships",
    "returns"
  ],
  "properties": {
    "version": {
      "const": "1.0",
      "description": "当前 ontology-platform-unified-skill 的 OQL 协议版本。此次仅同步 ASSOCIATION_QUERY 关联聚合语法，不做全 Skill 版本迁移。"
    },
    "schemaRef": {
      "type": "string",
      "minLength": 1,
      "description": "本体 schema 标识。"
    },
    "strict": {
      "type": "boolean",
      "default": true,
      "description": "是否严格校验，默认 true。"
    },
    "operation": {
      "const": "ASSOCIATION_QUERY",
      "description": "显式依赖本体关系路径的查询；既可返回明细，也可在关系展开后聚合。"
    },
    "objects": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/object"
      },
      "minItems": 2,
      "description": "路径涉及对象声明。"
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/relationship"
      },
      "minItems": 1,
      "description": "关系路径，按跳数顺序声明。"
    },
    "conditions": {
      "$ref": "#/definitions/condition",
      "description": "关系展开后的聚合前明细过滤；不用时省略。"
    },
    "returns": {
      "oneOf": [
        {
          "$ref": "#/definitions/detailReturns"
        },
        {
          "$ref": "#/definitions/aggregateReturns"
        }
      ],
      "description": "两种互斥返回模式：明细模式 FIELDS/EXPR/FUNCTION；聚合模式 GROUP_BY/METRIC。聚合模式至少包含一个 METRIC，由执行前校验保证。"
    },
    "aggregateFilter": {
      "$ref": "#/definitions/aggregateFilter",
      "description": "仅聚合模式使用；聚合后过滤，metricAlias 必须引用同层 METRIC.alias。"
    },
    "orders": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/order"
      },
      "minItems": 1,
      "description": "排序；聚合模式优先引用 GROUP_BY/METRIC alias。"
    },
    "maxResults": {
      "$ref": "#/definitions/maxResults",
      "description": "最大返回条数。"
    },
    "sourceQuery": {
      "$ref": "#/definitions/sourceQuery",
      "description": "中间结果查询。"
    },
    "options": {
      "$ref": "#/definitions/options",
      "description": "执行选项。"
    },
    "extensions": {
      "$ref": "#/definitions/extensions",
      "description": "业务扩展参数。"
    }
  },
  "definitions": {
    "alias": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9]*$",
      "description": "对象/关系别名；ref、from、to 必须引用已声明别名。"
    },
    "field": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          {
            "const": "*"
          },
          {
            "pattern": "^(ID|NAME)\\("
          }
        ]
      },
      "description": "普通本体属性名；条件/排序/表达式中不得使用 * 或 ID()/NAME()。"
    },
    "idNameField": {
      "type": "string",
      "pattern": "^(ID|NAME)\\([A-Za-z_][A-Za-z0-9_]*\\)$",
      "description": "仅用于 returns.kind=FUNCTION.field，函数名必须大写。"
    },
    "value": {
      "type": [
        "string",
        "number",
        "integer",
        "boolean"
      ],
      "description": "条件值，按真实类型生成。"
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objectType",
        "alias"
      ],
      "description": "本体对象声明；实例筛选放 conditions。",
      "properties": {
        "objectType": {
          "type": "string",
          "minLength": 1,
          "description": "本体对象类型。"
        },
        "alias": {
          "$ref": "#/definitions/alias"
        },
        "fromSource": {
          "type": "string",
          "minLength": 1,
          "description": "引用 sourceQuery[].outputAs。"
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relationshipType",
        "alias",
        "from",
        "to"
      ],
      "description": "关系路径声明；from/to 引用 objects alias。",
      "properties": {
        "relationshipType": {
          "type": "string",
          "minLength": 1,
          "description": "本体关系类型。"
        },
        "alias": {
          "$ref": "#/definitions/alias"
        },
        "from": {
          "$ref": "#/definitions/alias"
        },
        "to": {
          "$ref": "#/definitions/alias"
        },
        "direction": {
          "enum": [
            "OUTBOUND",
            "INBOUND",
            "BOTH"
          ],
          "description": "本体关系遍历方向。"
        },
        "mode": {
          "enum": [
            "ONE",
            "LIST"
          ],
          "description": "ONE 期望单条，LIST 允许多条。"
        }
      }
    },
    "fieldExpr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref",
        "field"
      ],
      "description": "字段表达式。",
      "properties": {
        "kind": {
          "const": "FIELD"
        },
        "ref": {
          "$ref": "#/definitions/alias"
        },
        "field": {
          "$ref": "#/definitions/field"
        }
      }
    },
    "valueExpr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "description": "字面量表达式。",
      "properties": {
        "kind": {
          "const": "VALUE"
        },
        "value": {}
      }
    },
    "literalExpr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref",
        "field"
      ],
      "anyOf": [
        {
          "required": [
            "posLITERAL"
          ]
        },
        {
          "required": [
            "endLITERAL"
          ]
        },
        {
          "required": [
            "decimalsLITERAL"
          ]
        }
      ],
      "description": "带字面量参数的字段表达式，用于 SUBSTRING/ROUND 等内置函数。",
      "properties": {
        "kind": {
          "const": "FIELD"
        },
        "ref": {
          "$ref": "#/definitions/alias"
        },
        "field": {
          "$ref": "#/definitions/field"
        },
        "posLITERAL": {
          "type": "integer"
        },
        "endLITERAL": {
          "type": "integer"
        },
        "decimalsLITERAL": {
          "type": "integer"
        }
      }
    },
    "functionExpr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "args"
      ],
      "description": "受控函数表达式；ID/NAME 不从此处表达。",
      "properties": {
        "kind": {
          "const": "FUNCTION"
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "not": {
            "enum": [
              "ID",
              "NAME",
              "id",
              "name"
            ]
          }
        },
        "args": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/definitions/fieldExpr"
              },
              {
                "$ref": "#/definitions/valueExpr"
              },
              {
                "$ref": "#/definitions/literalExpr"
              },
              {
                "$ref": "#/definitions/functionExpr"
              }
            ]
          }
        },
        "alias": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "expr": {
      "oneOf": [
        {
          "$ref": "#/definitions/fieldExpr"
        },
        {
          "$ref": "#/definitions/valueExpr"
        },
        {
          "$ref": "#/definitions/literalExpr"
        },
        {
          "$ref": "#/definitions/functionExpr"
        }
      ],
      "description": "FIELD/VALUE/LITERAL/FUNCTION 表达式。"
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operator"
      ],
      "oneOf": [
        {
          "required": [
            "ref",
            "field"
          ]
        },
        {
          "required": [
            "left"
          ]
        }
      ],
      "description": "聚合前原子条件。",
      "properties": {
        "kind": {
          "const": "PREDICATE"
        },
        "ref": {
          "$ref": "#/definitions/alias"
        },
        "field": {
          "$ref": "#/definitions/field"
        },
        "left": {
          "$ref": "#/definitions/expr"
        },
        "operator": {
          "enum": [
            "EQ",
            "NE",
            "GT",
            "GTE",
            "LT",
            "LTE",
            "IN",
            "NOT_IN",
            "BETWEEN",
            "LIKE",
            "CONTAINS",
            "STARTS_WITH",
            "ENDS_WITH",
            "IS_NULL",
            "IS_NOT_NULL",
            "IS_EMPTY",
            "IS_NOT_EMPTY",
            "EXISTS",
            "NOT_EXISTS"
          ]
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/value"
          }
        },
        "subquery": {
          "type": "object"
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "relation",
        "children"
      ],
      "description": "条件逻辑组；NOT 仅一个子条件。",
      "properties": {
        "kind": {
          "const": "GROUP"
        },
        "relation": {
          "enum": [
            "AND",
            "OR",
            "NOT"
          ]
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/condition"
          },
          "minItems": 1
        }
      }
    },
    "condition": {
      "oneOf": [
        {
          "$ref": "#/definitions/predicate"
        },
        {
          "$ref": "#/definitions/group"
        }
      ],
      "description": "聚合前过滤条件树。"
    },
    "order": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "direction"
      ],
      "description": "排序；明细模式可带 ref，聚合模式优先按返回 alias。",
      "properties": {
        "ref": {
          "$ref": "#/definitions/alias"
        },
        "field": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "^(ID|NAME)\\("
          }
        },
        "direction": {
          "enum": [
            "ASC",
            "DESC"
          ]
        }
      }
    },
    "maxResults": {
      "type": "integer",
      "minimum": 1,
      "description": "当前 Skill 执行契约保留数字格式，如 1000。"
    },
    "sourceQuery": {
      "type": "array",
      "description": "多阶段中间查询；outputAs 可被 objects[].fromSource 引用。",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "outputAs"
        ],
        "properties": {
          "outputAs": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": true,
      "description": "执行选项；无明确要求时省略。"
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true,
      "description": "业务扩展参数；无明确约定时省略。"
    },
    "returnField": {
      "oneOf": [
        {
          "$ref": "#/definitions/field"
        },
        {
          "const": "*"
        }
      ],
      "description": "普通返回字段；优先显式列字段。"
    },
    "fieldsReturn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref",
        "fields"
      ],
      "description": "明细模式：返回对象/关系字段。",
      "properties": {
        "kind": {
          "const": "FIELDS"
        },
        "ref": {
          "$ref": "#/definitions/alias"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/returnField"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "singleFieldReturn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref",
        "field"
      ],
      "description": "明细模式：返回单字段，可选 alias。",
      "properties": {
        "kind": {
          "const": "FIELDS"
        },
        "ref": {
          "$ref": "#/definitions/alias"
        },
        "field": {
          "$ref": "#/definitions/returnField"
        },
        "alias": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "exprReturn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "expr",
        "alias"
      ],
      "description": "明细模式：返回派生表达式。",
      "properties": {
        "kind": {
          "const": "EXPR"
        },
        "expr": {
          "$ref": "#/definitions/expr"
        },
        "alias": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "idNameReturn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref",
        "field",
        "alias"
      ],
      "description": "明细模式：返回 ID(field)/NAME(field) 维度语义。",
      "properties": {
        "kind": {
          "const": "FUNCTION"
        },
        "ref": {
          "$ref": "#/definitions/alias"
        },
        "field": {
          "$ref": "#/definitions/idNameField"
        },
        "alias": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "functionReturn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "args",
        "alias"
      ],
      "description": "明细模式：直接返回受控函数表达式结果。",
      "properties": {
        "kind": {
          "const": "FUNCTION"
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "not": {
            "enum": [
              "ID",
              "NAME",
              "id",
              "name"
            ]
          }
        },
        "args": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/definitions/fieldExpr"
              },
              {
                "$ref": "#/definitions/valueExpr"
              },
              {
                "$ref": "#/definitions/literalExpr"
              },
              {
                "$ref": "#/definitions/functionExpr"
              }
            ]
          }
        },
        "alias": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "groupByReturn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "alias"
      ],
      "oneOf": [
        {
          "required": [
            "ref",
            "field"
          ]
        },
        {
          "required": [
            "expr"
          ]
        }
      ],
      "description": "聚合模式：分组字段；普通分组用 ref+field，函数型分组用 expr。",
      "properties": {
        "kind": {
          "const": "GROUP_BY"
        },
        "ref": {
          "$ref": "#/definitions/alias"
        },
        "field": {
          "$ref": "#/definitions/field"
        },
        "expr": {
          "$ref": "#/definitions/expr"
        },
        "alias": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "metricReturn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "function",
        "ref",
        "field",
        "alias"
      ],
      "description": "聚合模式：COUNT/SUM/AVG/MIN/MAX 指标；不暴露 distinct 控制字段。",
      "properties": {
        "kind": {
          "const": "METRIC"
        },
        "function": {
          "enum": [
            "COUNT",
            "SUM",
            "AVG",
            "MIN",
            "MAX"
          ]
        },
        "ref": {
          "$ref": "#/definitions/alias"
        },
        "field": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "^(ID|NAME)\\("
          }
        },
        "alias": {
          "type": "string",
          "minLength": 1,
          "description": "可被 aggregateFilter.metricAlias 引用。"
        }
      }
    },
    "aggregateFilter": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "metricAlias",
            "operator"
          ],
          "description": "聚合后指标过滤。",
          "properties": {
            "kind": {
              "const": "METRIC_PREDICATE"
            },
            "metricAlias": {
              "type": "string",
              "minLength": 1
            },
            "operator": {
              "enum": [
                "EQ",
                "NE",
                "GT",
                "GTE",
                "LT",
                "LTE",
                "BETWEEN",
                "IN",
                "NOT_IN",
                "IS_NULL",
                "IS_NOT_NULL"
              ]
            },
            "values": {
              "type": "array"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "relation",
            "children"
          ],
          "description": "聚合过滤逻辑组。",
          "properties": {
            "kind": {
              "const": "GROUP"
            },
            "relation": {
              "enum": [
                "AND",
                "OR",
                "NOT"
              ]
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/aggregateFilter"
              },
              "minItems": 1
            }
          }
        }
      ],
      "description": "仅 ASSOCIATION_QUERY 聚合模式使用，引用 METRIC.alias。"
    },
    "detailReturns": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/definitions/fieldsReturn"
          },
          {
            "$ref": "#/definitions/singleFieldReturn"
          },
          {
            "$ref": "#/definitions/exprReturn"
          },
          {
            "$ref": "#/definitions/idNameReturn"
          },
          {
            "$ref": "#/definitions/functionReturn"
          }
        ]
      },
      "minItems": 1,
      "description": "ASSOCIATION_QUERY 明细返回模式。"
    },
    "aggregateReturns": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/definitions/groupByReturn"
          },
          {
            "$ref": "#/definitions/metricReturn"
          }
        ]
      },
      "minItems": 1,
      "description": "ASSOCIATION_QUERY 聚合返回模式；至少一个 METRIC 由执行前语义校验保证。"
    }
  }
}