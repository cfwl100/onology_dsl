{
  "title": "OQL ASSOCIATION_QUERY JSON Schema",
  "description": "对象关系/路径关联查询；用于一跳关系导航和多跳路径。",
  "type": "object",
  "additionalProperties": false,
  "required": ["version","schemaRef","operation","objects","relationships","returns"],
  "properties": {
    "version": {"const":"1.0","description":"OQL 协议版本。"},
    "schemaRef": {"type":"string","minLength":1,"description":"本体 schema 标识。"},
    "strict": {"type":"boolean","default":true,"description":"是否严格校验，默认 true。"},
    "conditions": {"$ref":"#/definitions/condition","description":"过滤条件；不用时省略。"},
    "orders": {"type":"array","items":{"$ref":"#/definitions/order"},"minItems":1,"description":"排序；不用时省略。"},
    "maxResults": {"$ref":"#/definitions/maxResults","description":"最大返回条数。"},
    "sourceQuery": {"$ref":"#/definitions/sourceQuery","description":"中间结果查询。"},
    "options": {"$ref":"#/definitions/options","description":"执行选项。"},
    "extensions": {"$ref":"#/definitions/extensions","description":"业务扩展参数。"},
    "operation": {"const":"ASSOCIATION_QUERY","description":"对象关系/路径查询。"},
    "objects": {"type":"array","items":{"$ref":"#/definitions/object"},"minItems":2,"description":"路径涉及对象声明。"},
    "relationships": {"type":"array","items":{"$ref":"#/definitions/relationship"},"minItems":1,"description":"关系路径，按跳数顺序声明。"},
    "returns": {"type":"array","items":{"oneOf":[{"$ref":"#/definitions/fieldsReturn"},{"$ref":"#/definitions/singleFieldReturn"},{"$ref":"#/definitions/exprReturn"},{"$ref":"#/definitions/idNameReturn"},{"$ref":"#/definitions/functionReturn"}]},"minItems":1,"description":"返回字段/表达式/ID-NAME。"}
  },
  "definitions": {
    "alias": {"type":"string","minLength":1,"pattern":"^[A-Za-z][A-Za-z0-9]*$","description":"对象/关系别名；ref、from、to 必须引用已声明别名。"},
    "field": {"type":"string","minLength":1,"not":{"anyOf":[{"const":"*"},{"pattern":"^(ID|NAME)\\("}]},"description":"普通本体属性名；条件/排序/表达式中不得使用 * 或 ID()/NAME()。"},
    "idNameField": {"type":"string","pattern":"^(ID|NAME)\\([A-Za-z_][A-Za-z0-9_]*\\)$","description":"仅用于 returns.kind=FUNCTION.field，函数名必须大写。"},
    "value": {"type":["string","number","integer","boolean"],"description":"条件值，按真实类型生成。"},
    "object": {"type":"object","additionalProperties":false,"required":["objectType","alias"],"description":"本体对象声明；实例筛选放 conditions。","properties":{"objectType":{"type":"string","minLength":1,"description":"本体对象类型。"},"alias":{"$ref":"#/definitions/alias"},"fromSource":{"type":"string","minLength":1,"description":"引用 sourceQuery[].outputAs。"}}},
    "fieldExpr": {"type":"object","additionalProperties":false,"required":["kind","ref","field"],"description":"字段表达式。","properties":{"kind":{"const":"FIELD"},"ref":{"$ref":"#/definitions/alias"},"field":{"$ref":"#/definitions/field"}}},
    "valueExpr": {"type":"object","additionalProperties":false,"required":["kind","value"],"description":"字面量表达式。","properties":{"kind":{"const":"VALUE"},"value":{}}},
    "literalExpr": {"type":"object","additionalProperties":false,"required":["kind","ref","field"],"anyOf":[{"required":["posLITERAL"]},{"required":["endLITERAL"]},{"required":["decimalsLITERAL"]}],"description":"带字面量参数的字段表达式，用于内置函数如 SUBSTRING(posLITERAL, endLITERAL)、ROUND(decimalsLITERAL)。","properties":{"kind":{"const":"FIELD"},"ref":{"$ref":"#/definitions/alias"},"field":{"$ref":"#/definitions/field"},"posLITERAL":{"type":"integer","description":"SUBSTRING 起始位置（从1开始）。"},"endLITERAL":{"type":"integer","description":"SUBSTRING 结束位置。"},"decimalsLITERAL":{"type":"integer","description":"ROUND 小数位数。"}}},
    "functionExpr": {"type":"object","additionalProperties":false,"required":["kind","name","args"],"description":"内置函数表达式。支持数据库通用函数和时间函数：\n1. 数学函数：ABS(绝对值)、ROUND(四舍五入)、CEIL(向上取整)、FLOOR(向下取整)\n2. 字符串函数：LENGTH(长度)、LOWER(转小写)、UPPER(转大写)、TRIM(去首尾空格)、SUBSTRING(截取)、CONCAT(拼接)\n3. 空值处理：COALESCE(返回第一个非空值)、IFNULL(空值替换默认值)\n4. 时间函数：NOW(当前时间)、YEAR/MONTH/DAY/HOUR/MINUTE/SECOND(提取时间分量)、DATE_TRUNC(截断时间)、DATE_ADD/DATE_SUB(时间加减)、DATEDIFF(日期差)\n参数规范：args数组顺序对应函数参数顺序。参数类型：\n- FIELD类型：{kind:\"FIELD\", ref:\"对象别名\", field:\"字段名\"}\n- VALUE类型：{kind:\"VALUE\", value:字面量值}\n- LITERAL类型：{kind:\"FIELD\", ref:\"对象别名\", field:\"字段名\", posLITERAL:1, endLITERAL:5, decimalsLITERAL:2}，用于SUBSTRING(pos,end)和ROUND(decimals)\n- FUNCTION类型：嵌套函数表达式\nID/NAME不从此处表达，应使用idNameReturn。","properties":{"kind":{"const":"FUNCTION"},"namespace":{"type":"string","minLength":1,"description":"函数命名空间（可选）。"},"name":{"type":"string","minLength":1,"not":{"enum":["ID","NAME","id","name"]},"description":"函数名，必须大写，如ABS、ROUND、SUBSTRING、NOW、YEAR、DATE_ADD等。"},"args":{"type":"array","items":{"oneOf":[{"$ref":"#/definitions/fieldExpr"},{"$ref":"#/definitions/valueExpr"},{"$ref":"#/definitions/literalExpr"},{"$ref":"#/definitions/functionExpr"}]},"description":"函数参数数组，按参数顺序排列。"},"alias":{"type":"string","minLength":1,"description":"函数结果别名，供外层exprReturn引用。"}}},
    "expr": {"oneOf":[{"$ref":"#/definitions/fieldExpr"},{"$ref":"#/definitions/valueExpr"},{"$ref":"#/definitions/literalExpr"},{"$ref":"#/definitions/functionExpr"}],"description":"FIELD/VALUE/LITERAL/FUNCTION 表达式。内置函数支持的类型：数学函数(ABS/ROUND/CEIL/FLOOR)、字符串函数(LENGTH/LOWER/UPPER/TRIM/SUBSTRING/CONCAT)、空值处理(COALESCE/IFNULL)、时间函数(NOW/YEAR/MONTH/DAY/HOUR/MINUTE/SECOND/DATE_TRUNC/DATE_ADD/DATE_SUB/DATEDIFF)。"},
    "predicate": {"type":"object","additionalProperties":false,"required":["kind","operator"],"oneOf":[{"required":["ref","field"]},{"required":["left"]}],"description":"原子条件；普通条件用 ref+field，函数条件用 left。","properties":{"kind":{"const":"PREDICATE"},"ref":{"$ref":"#/definitions/alias"},"field":{"$ref":"#/definitions/field"},"left":{"$ref":"#/definitions/expr"},"operator":{"enum":["EQ","NE","GT","GTE","LT","LTE","IN","NOT_IN","BETWEEN","LIKE","CONTAINS","STARTS_WITH","ENDS_WITH","IS_NULL","IS_NOT_NULL","IS_EMPTY","IS_NOT_EMPTY","EXISTS","NOT_EXISTS"],"description":"比较/匹配操作符。"},"values":{"type":"array","items":{"$ref":"#/definitions/value"},"description":"比较值；BETWEEN 两个值，空值判断不填。"},"subquery":{"type":"object","description":"EXISTS/NOT_EXISTS 子查询。"}}},
    "group": {"type":"object","additionalProperties":false,"required":["kind","relation","children"],"description":"条件逻辑组；NOT 仅一个子条件。","properties":{"kind":{"const":"GROUP"},"relation":{"enum":["AND","OR","NOT"]},"children":{"type":"array","items":{"$ref":"#/definitions/condition"},"minItems":1}}},
    "condition": {"oneOf":[{"$ref":"#/definitions/predicate"},{"$ref":"#/definitions/group"}],"description":"聚合前过滤条件树。"},
    "order": {"type":"object","additionalProperties":false,"required":["field","direction"],"description":"排序；普通查询可带 ref，聚合查询优先按返回 alias。","properties":{"ref":{"$ref":"#/definitions/alias"},"field":{"type":"string","minLength":1,"not":{"pattern":"^(ID|NAME)\\("}},"direction":{"enum":["ASC","DESC"]}}},
    "maxResults": {"type":"integer","minimum":1,"description":"最大返回条数，数字格式，如 1000。"},
    "sourceQuery": {"type":"array","description":"多阶段中间查询；outputAs 可被 objects[].fromSource 引用。","items":{"type":"object","additionalProperties":true,"required":["outputAs"],"properties":{"outputAs":{"type":"string","minLength":1}}}},
    "options": {"type":"object","additionalProperties":true,"description":"执行选项；无明确要求时省略。"},
    "extensions": {"type":"object","additionalProperties":true,"description":"业务扩展参数；无明确约定时省略。"},
    "returnField": {"oneOf":[{"$ref":"#/definitions/field"},{"const":"*"}],"description":"普通返回字段；优先显式列字段，必要时可用 *。"},
    "fieldsReturn": {"type":"object","additionalProperties":false,"required":["kind","ref","fields"],"description":"返回对象/关系字段。","properties":{"kind":{"const":"FIELDS"},"ref":{"$ref":"#/definitions/alias"},"fields":{"type":"array","items":{"$ref":"#/definitions/returnField"},"minItems":1,"uniqueItems":true}}},
    "exprReturn": {"type":"object","additionalProperties":false,"required":["kind","expr","alias"],"description":"返回派生表达式。","properties":{"kind":{"const":"EXPR"},"expr":{"$ref":"#/definitions/expr"},"alias":{"type":"string","minLength":1}}},
    "idNameReturn": {"type":"object","additionalProperties":false,"required":["kind","ref","field","alias"],"description":"返回 ID(field)/NAME(field) 维度语义。","properties":{"kind":{"const":"FUNCTION"},"ref":{"$ref":"#/definitions/alias"},"field":{"$ref":"#/definitions/idNameField"},"alias":{"type":"string","minLength":1}}},
    "functionReturn": {"type":"object","additionalProperties":false,"required":["kind","name","args","alias"],"description":"直接返回函数表达式结果。","properties":{"kind":{"const":"FUNCTION"},"namespace":{"type":"string","minLength":1,"description":"函数命名空间（可选）。"},"name":{"type":"string","minLength":1,"not":{"enum":["ID","NAME","id","name"]},"description":"函数名，必须大写，如ABS、ROUND、SUBSTRING、NOW、YEAR、DATE_ADD等。"},"args":{"type":"array","items":{"oneOf":[{"$ref":"#/definitions/fieldExpr"},{"$ref":"#/definitions/valueExpr"},{"$ref":"#/definitions/literalExpr"},{"$ref":"#/definitions/functionExpr"}]},"description":"函数参数数组，按参数顺序排列。"},"alias":{"type":"string","minLength":1,"description":"函数结果别名，供外层引用。"}}},
    "singleFieldReturn": {"type":"object","additionalProperties":false,"required":["kind","ref","field"],"description":"返回单个字段，可选 alias。","properties":{"kind":{"const":"FIELDS"},"ref":{"$ref":"#/definitions/alias"},"field":{"$ref":"#/definitions/returnField"},"alias":{"type":"string","minLength":1}}},
    "relationship": {"type":"object","additionalProperties":false,"required":["relationshipType","alias","from","to"],"description":"关系路径声明；from/to 引用 objects alias。","properties":{"relationshipType":{"type":"string","minLength":1,"description":"本体关系类型。"},"alias":{"$ref":"#/definitions/alias"},"from":{"$ref":"#/definitions/alias"},"to":{"$ref":"#/definitions/alias"},"direction":{"type":"string","minLength":1,"description":"关系方向，如 OUTBOUND/INBOUND。"},"mode":{"enum":["ONE","LIST"],"description":"ONE 期望单条，LIST 允许多条。"}}}
  }
}
