{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cfwl100/onology_dsl/blob/main/docs/schemas/oag-software-subgraph-response.schema.json",
  "title": "OAG 统一 V2 语义子图检索响应（V1 能力全覆盖）",
  "description": "V2 支持自然语言 query 与结构化 entities，完整覆盖 V1 ObjectType、Property、Relationship、Function、Action 检索及返回能力，并支持正式 V2 定义中的 RelationshipProperty。seedNodes、propertyValuesLinks、semanticExtensions、Property dataType 为按租户配置和有效输入模式出现的新增扩展，不要求 query-only 都有值映射。",
  "type": "object",
  "required": [
    "resultCode",
    "resultMessage",
    "result"
  ],
  "properties": {
    "resultCode": {
      "type": "integer",
      "description": "业务结果码；附件成功值为 200。"
    },
    "resultMessage": {
      "type": "string",
      "description": "业务结果信息；附件为 success。"
    },
    "result": {
      "$ref": "#/$defs/SubgraphResult"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "SubgraphResult": {
      "type": "object",
      "description": "V2 统一响应：V1 nodes/edges/functions/actions 等基本结果保留；可随检索模式和租户配置加入 seedNodes/propertyValuesLinks/semanticExtensions 及 Property 数据类型。",
      "properties": {
        "seedNodes": {
          "type": "array",
          "description": "显式种子与值命中种子；实测存在重复 sourceObjectType，不能按名称假设天然唯一。",
          "items": {
            "$ref": "#/$defs/SeedNode"
          }
        },
        "propertyValuesLinks": {
          "type": "array",
          "description": "值候选链接证据，可包含同一对象的多条记录。",
          "items": {
            "$ref": "#/$defs/PropertyValuesLink"
          }
        },
        "nodes": {
          "type": "array",
          "description": "本体顶点，包含 ObjectType、Property 等。",
          "items": {
            "$ref": "#/$defs/GraphNode"
          }
        },
        "edges": {
          "type": "array",
          "description": "有向本体图边，保留真实 sourceId / targetId。",
          "items": {
            "$ref": "#/$defs/GraphEdge"
          }
        },
        "functions": {
          "type": "array",
          "description": "附件为 []；非空 Function DTO 尚无法据此确定，维持 V1 兼容开放结构。",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "actions": {
          "type": "array",
          "description": "附件为 []；非空 Action DTO 尚无法据此确定，维持 V1 兼容开放结构。",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "semanticExtensions": {
          "$ref": "#/$defs/SemanticExtensions"
        }
      },
      "required": [
        "nodes",
        "edges",
        "functions",
        "actions"
      ],
      "additionalProperties": true
    },
    "SeedNode": {
      "type": "object",
      "description": "种子节点条目。",
      "properties": {
        "sourceObjectType": {
          "type": "string",
          "description": "业务输入或值链接命中的源对象名称。"
        },
        "targetObjectTypes": {
          "type": "array",
          "description": "归属到本体的候选对象列表。",
          "items": {
            "$ref": "#/$defs/TargetObjectType"
          }
        }
      },
      "required": [
        "sourceObjectType",
        "targetObjectTypes"
      ],
      "additionalProperties": true
    },
    "TargetObjectType": {
      "type": "object",
      "description": "源对象下的本体对象候选。",
      "properties": {
        "id": {
          "type": "string",
          "description": "本体 ObjectType ID；附件发现空字符串，故不能强制 minLength 1。"
        },
        "name": {
          "type": "string",
          "description": "本体对象规范名称。"
        },
        "score": {
          "type": "number",
          "description": "附件中的直接锚点使用 0.0，不应理解为未命中。"
        },
        "propertyLinks": {
          "type": "array",
          "description": "源属性到真实属性的链接记录。",
          "items": {
            "$ref": "#/$defs/PropertyLink"
          }
        },
        "descriptionZh": {
          "type": [
            "string",
            "null"
          ]
        },
        "descriptionEn": {
          "type": [
            "string",
            "null"
          ]
        },
        "synonyms": {
          "type": [
            "string",
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "description": "附件为 null；真实非空载荷需以 V1 DTO 为准。"
        }
      },
      "required": [
        "name",
        "id"
      ],
      "additionalProperties": true
    },
    "PropertyLink": {
      "type": "object",
      "description": "附件所有 propertyLinks 均为 []；非空结构参照软件详细设计，保留扩展字段。",
      "properties": {
        "sourceProperty": {
          "type": "string",
          "description": "业务侧的属性名称。"
        },
        "targetProperties": {
          "type": "array",
          "description": "真实本体属性候选。",
          "items": {
            "$ref": "#/$defs/TargetProperty"
          }
        }
      },
      "required": [],
      "additionalProperties": true
    },
    "TargetProperty": {
      "type": "object",
      "description": "属性候选。",
      "properties": {
        "id": {
          "type": "string",
          "description": "本体属性 ID。"
        },
        "name": {
          "type": "string",
          "description": "本体属性规范名称。"
        }
      },
      "required": [],
      "additionalProperties": true
    },
    "PropertyValuesLink": {
      "type": "object",
      "description": "值链接分组结果。",
      "properties": {
        "sourceObjectType": {
          "type": "string",
          "description": "值候选所属的本体对象名称。"
        },
        "sourceObjectTypeId": {
          "type": "string",
          "description": "值候选所属本体对象 ID；截图存在该字段。"
        },
        "valuesLinks": {
          "type": "array",
          "description": "该对象上的实际归属属性和值映射候选。",
          "items": {
            "$ref": "#/$defs/ValuesLink"
          }
        }
      },
      "required": [
        "sourceObjectType",
        "valuesLinks"
      ],
      "additionalProperties": true
    },
    "ValuesLink": {
      "type": "object",
      "description": "真实属性归属及对应值候选。",
      "properties": {
        "sourceProperty": {
          "type": "string",
          "description": "解析后归属 Property 名称。"
        },
        "sourcePropertyId": {
          "type": "string",
          "description": "解析后归属 Property ID。"
        },
        "sourceValue": {
          "type": "string",
          "description": "用户原始值。"
        },
        "valuesMapping": {
          "type": "array",
          "description": "候选标准值；可能一对多，不能强制 Top1。",
          "items": {
            "$ref": "#/$defs/ValueCandidate"
          }
        }
      },
      "required": [
        "sourceValue",
        "valuesMapping"
      ],
      "additionalProperties": true
    },
    "ValueCandidate": {
      "type": "object",
      "description": "值链接候选（包含分数）。",
      "properties": {
        "canonicalValue": {
          "type": "string",
          "description": "被检索到的标准值。"
        },
        "defaultDataValue": {
          "type": "string",
          "description": "标准值对应默认物理数据值。"
        },
        "score": {
          "type": "number",
          "description": "候选分数，不代表已通过业务规则判定最终可用。"
        }
      },
      "required": [
        "canonicalValue",
        "defaultDataValue"
      ],
      "additionalProperties": true
    },
    "GraphNode": {
      "type": "object",
      "description": "V2 节点结构：必须覆盖 V1 的实体/属性及关系语义；按租户配置可给 label=property 的 nodes[].properties 附加 dataType；V2 增强默认无向路径不改变真实有向边。",
      "properties": {
        "id": {
          "type": "string",
          "description": "顶点 ID。"
        },
        "label": {
          "type": "string",
          "description": "图库节点类型；实测 objectType / property。"
        },
        "properties": {
          "type": "object",
          "description": "V2 节点属性容器；label=property 的 V2 新增类型值使用 dataType（取自 OMS Property 定义，类型缺失时不伪造）。本 Schema 不要求所有旧或非 Property 节点都存在此字段。",
          "additionalProperties": true,
          "properties": {
            "dataType": {
              "type": "string",
              "description": "**V2-only**：当 GraphNode.label 为 property 时，可附带从 OMS 权威属性定义得到的字段数据类型。V1 使用原响应结构，不增加这个字段。"
            }
          }
        }
      },
      "required": [
        "id",
        "label",
        "properties"
      ],
      "additionalProperties": true
    },
    "GraphEdge": {
      "type": "object",
      "description": "本体关系边，保留原始方向。",
      "properties": {
        "sourceId": {
          "type": "string",
          "description": "真实有向边起点 ID。"
        },
        "targetId": {
          "type": "string",
          "description": "真实有向边终点 ID。"
        },
        "edgeType": {
          "type": "string",
          "description": "边类型；实测 defines_relation / has_property。"
        },
        "propertyMap": {
          "type": "object",
          "description": "原 V1 边属性映射，可能包含 name、junctionConfig、businessSemanticDescription 等字符串字段。",
          "additionalProperties": true
        }
      },
      "required": [
        "sourceId",
        "targetId",
        "edgeType",
        "propertyMap"
      ],
      "additionalProperties": true
    },
    "SemanticExtensions": {
      "type": "object",
      "description": "V2 可选语义扩展：若发生值映射时可返回 valueMappings；内部 Skill query-only 不要求这个扩展，V1 迁移前仍沿用原响应。",
      "properties": {
        "valueMappings": {
          "type": "array",
          "description": "附件现网返回为扁平映射数组；嵌套 objectType/property 形态属于拟议后续契约。",
          "items": {
            "$ref": "#/$defs/FlatValueMapping"
          }
        }
      },
      "required": [
        "valueMappings"
      ],
      "additionalProperties": true
    },
    "FlatValueMapping": {
      "type": "object",
      "description": "现网样例支持同一个 sourceValue 返回多条命中，不自动唯一化。",
      "properties": {
        "propertyName": {
          "type": "string",
          "description": "Property 名称；附件为扁平字段。"
        },
        "objectTypeName": {
          "type": "string",
          "description": "ObjectType 名称；附件为扁平字段。"
        },
        "sourceValue": {
          "type": "string",
          "description": "业务原始值。"
        },
        "canonicalValue": {
          "type": "string",
          "description": "索引检索的标准值。"
        },
        "defaultDataValue": {
          "type": "string",
          "description": "默认数据存储值。"
        },
        "dataType": {
          "type": "string",
          "description": "返回数据类型；实测 string。"
        }
      },
      "required": [
        "propertyName",
        "objectTypeName",
        "sourceValue",
        "canonicalValue",
        "defaultDataValue"
      ],
      "additionalProperties": true
    }
  }
}
