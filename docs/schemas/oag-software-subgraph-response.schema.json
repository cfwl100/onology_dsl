{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cfwl100/onology_dsl/blob/main/docs/schemas/oag-software-subgraph-response.schema.json",
  "title": "OAG V2 响应 Schema（实体示例2-1的节点扩展为准）",
  "description": "Property 的 propertyEnumValues/propertyInstanceValues 位于 nodes[] 顶层，不能挂到 properties 里；附件 query 示例1-2 和 entities 示例2-1 使用两套节点边形态，当前兼容两者，待后端统一 DTO。",
  "type": "object",
  "required": [
    "resultCode",
    "resultMessage",
    "result"
  ],
  "properties": {
    "resultCode": {
      "type": [
        "string",
        "integer"
      ],
      "description": "业务结果码；附件成功值为 200。"
    },
    "resultMessage": {
      "type": "string",
      "description": "业务结果信息；附件为 success。"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/SubgraphResult"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": true,
  "$defs": {
    "SubgraphResult": {
      "type": "object",
      "description": "V2 图响应，保留 seedNodes 和可选实例诊断 propertyValuesLinks；不再允许 semanticExtensions。EnumType 全量枚举统一装配在 Property 节点。",
      "properties": {
        "seedNodes": {
          "type": "array",
          "description": "显式种子与值命中种子；实测存在重复 sourceObjectType，不能按名称假设天然唯一。",
          "items": {
            "$ref": "#/$defs/SeedNode"
          }
        },
        "propertyValuesLinks": {
          "type": "array",
          "description": "与 seedNodes 并列的链接证据，包括未命中且 valuesMapping=[] 的对象组，不能假设仅包含最终种子。",
          "items": {
            "$ref": "#/$defs/PropertyValuesLink"
          }
        },
        "nodes": {
          "type": "array",
          "description": "query 可用旧式 type 节点，entities 示例2-1 使用 label/properties；属性双值数组挂在节点顶层。",
          "items": {
            "$ref": "#/$defs/GraphNode"
          }
        },
        "edges": {
          "type": "array",
          "description": "有向本体图边，保留真实 sourceId / targetId。",
          "items": {
            "$ref": "#/$defs/GraphEdge"
          }
        },
        "functions": {
          "type": "array",
          "description": "附件为 []；非空 Function DTO 尚无法据此确定，维持 V1 兼容开放结构。",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "actions": {
          "type": "array",
          "description": "附件为 []；非空 Action DTO 尚无法据此确定，维持 V1 兼容开放结构。",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "required": [
        "nodes",
        "edges",
        "functions",
        "actions"
      ],
      "additionalProperties": true,
      "not": {
        "required": [
          "semanticExtensions"
        ]
      }
    },
    "SeedNode": {
      "type": "object",
      "description": "种子节点条目。",
      "properties": {
        "sourceObjectType": {
          "type": "string",
          "description": "业务输入或值链接命中的源对象名称。"
        },
        "targetObjectTypes": {
          "type": "array",
          "description": "归属到本体的候选对象列表。",
          "items": {
            "$ref": "#/$defs/TargetObjectType"
          }
        }
      },
      "required": [
        "sourceObjectType",
        "targetObjectTypes"
      ],
      "additionalProperties": true
    },
    "TargetObjectType": {
      "type": "object",
      "description": "源对象下的本体对象候选。",
      "properties": {
        "id": {
          "type": "string",
          "description": "本体 ObjectType ID；附件发现空字符串，故不能强制 minLength 1。"
        },
        "name": {
          "type": "string",
          "description": "本体对象规范名称。"
        },
        "score": {
          "type": "number",
          "description": "附件中的直接锚点使用 0.0，不应理解为未命中。"
        },
        "propertyLinks": {
          "type": "array",
          "description": "源属性到真实属性的链接记录。",
          "items": {
            "$ref": "#/$defs/PropertyLink"
          }
        },
        "descriptionZh": {
          "type": [
            "string",
            "null"
          ]
        },
        "descriptionEn": {
          "type": [
            "string",
            "null"
          ]
        },
        "synonyms": {
          "type": [
            "string",
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "description": "附件为 null；真实非空载荷需以 V1 DTO 为准。"
        }
      },
      "required": [
        "name",
        "id"
      ],
      "additionalProperties": true
    },
    "PropertyLink": {
      "type": "object",
      "description": "附件所有 propertyLinks 均为 []；非空结构参照软件详细设计，保留扩展字段。",
      "properties": {
        "sourceProperty": {
          "type": "string",
          "description": "业务侧的属性名称。"
        },
        "targetProperties": {
          "type": "array",
          "description": "真实本体属性候选。",
          "items": {
            "$ref": "#/$defs/TargetProperty"
          }
        }
      },
      "required": [],
      "additionalProperties": true
    },
    "TargetProperty": {
      "type": "object",
      "description": "属性候选。",
      "properties": {
        "id": {
          "type": "string",
          "description": "本体属性 ID。"
        },
        "name": {
          "type": "string",
          "description": "本体属性规范名称。"
        }
      },
      "required": [],
      "additionalProperties": true
    },
    "PropertyValuesLink": {
      "type": "object",
      "description": "值链接分组结果。",
      "properties": {
        "sourceObjectType": {
          "type": "string",
          "description": "值候选所属的本体对象名称。"
        },
        "sourceObjectTypeId": {
          "type": "string",
          "description": "值候选所属本体对象 ID；截图存在该字段。"
        },
        "valuesLinks": {
          "type": "array",
          "description": "该对象上的实际归属属性和值映射候选。",
          "items": {
            "$ref": "#/$defs/ValuesLink"
          }
        }
      },
      "required": [
        "sourceObjectType",
        "valuesLinks"
      ],
      "additionalProperties": true
    },
    "ValuesLink": {
      "type": "object",
      "description": "真实属性归属及对应值候选。",
      "properties": {
        "sourceProperty": {
          "type": "string",
          "description": "解析后归属 Property 名称。"
        },
        "sourcePropertyId": {
          "type": "string",
          "description": "解析后归属 Property ID。"
        },
        "sourceValue": {
          "type": "string",
          "description": "用户原始值。"
        },
        "valuesMapping": {
          "type": "array",
          "description": "可选实例候选链接诊断，只对应 t_oag_instance_{ontology_id} 的 Instance Value；不可携带 Enum Value 值映射。",
          "items": {
            "$ref": "#/$defs/ValueCandidate"
          }
        }
      },
      "required": [
        "sourceValue",
        "valuesMapping"
      ],
      "additionalProperties": true
    },
    "ValueCandidate": {
      "type": "object",
      "description": "候选值映射 canonicalValue/defaultDataValue/score，用于 propertyValuesLinks 的链接证据。",
      "properties": {
        "canonicalValue": {
          "type": "string",
          "description": "被检索到的标准值。"
        },
        "score": {
          "type": "number",
          "description": "候选分数，不代表已通过业务规则判定最终可用。"
        },
        "defaultDataValue": {
          "type": "string",
          "description": "附件 propertyValuesLinks.valuesMapping 中实际存在的字段，注意和 propertyInstanceValues 不同。"
        }
      },
      "required": [
        "canonicalValue"
      ],
      "additionalProperties": true
    },
    "GraphNode": {
      "type": "object",
      "description": "兼容 label/properties 新式节点和 query 示例1-2 的 type/display 旧式节点。",
      "properties": {
        "id": {
          "type": "string",
          "description": "顶点 ID。"
        },
        "label": {
          "type": "string",
          "description": "图库节点类型；实测 objectType / property。"
        },
        "properties": {
          "type": "object",
          "description": "仅含 dataType、enumDataType、name、display、description、primaryKeys 等元数据；双值数组不在此处",
          "additionalProperties": true,
          "properties": {
            "dataType": {
              "type": "string",
              "description": "仅 V2 Property 的 OMS 权威数据类型；当类型为枚举或存在真实 EnumType 绑定时查询全量 values[]。"
            },
            "enumDataType": {
              "type": "string",
              "description": "枚举实际数据类型，dataType=enum 时返回"
            }
          }
        },
        "type": {
          "type": "string",
          "description": "query 示例1-2 节点类型 ObjectType/Property"
        },
        "display": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "propertyEnumValues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PropertyEnumValue"
          },
          "description": "枚举型 Property 全量 EnumType/values[]，位置为 nodes[] 顶层"
        },
        "propertyInstanceValues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PropertyInstanceValue"
          },
          "description": "允许语义检索的 Property 链接到的实例取值，位置为 nodes[] 顶层"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "label": {
                "const": "property"
              }
            },
            "required": [
              "label"
            ]
          },
          "then": {
            "properties": {
              "properties": {
                "required": [
                  "dataType"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "label": {
                "const": "property"
              },
              "properties": {
                "type": "object",
                "properties": {
                  "dataType": {
                    "const": "enum"
                  }
                },
                "required": [
                  "dataType"
                ]
              }
            },
            "required": [
              "label",
              "properties"
            ]
          },
          "then": {
            "required": [
              "propertyEnumValues"
            ],
            "properties": {
              "properties": {
                "required": [
                  "enumDataType"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "label": {
                "const": "objectType"
              }
            },
            "required": [
              "label"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "propertyEnumValues"
                  ]
                },
                {
                  "required": [
                    "propertyInstanceValues"
                  ]
                }
              ]
            }
          }
        }
      ],
      "anyOf": [
        {
          "required": [
            "label",
            "properties"
          ]
        },
        {
          "required": [
            "type"
          ]
        }
      ]
    },
    "GraphEdge": {
      "type": "object",
      "description": "兼容 entities 示例2-1 sourceId/targetId/edgeType/propertyMap 与 query 示例1-2 id/name/display 等历史形态。",
      "properties": {
        "sourceId": {
          "type": "string",
          "description": "真实有向边起点 ID。"
        },
        "targetId": {
          "type": "string",
          "description": "真实有向边终点 ID。"
        },
        "edgeType": {
          "type": "string",
          "description": "边类型；实测 defines_relation / has_property。"
        },
        "propertyMap": {
          "type": "object",
          "description": "原 V1 边属性映射，可能包含 name、junctionConfig、businessSemanticDescription 等字符串字段。",
          "additionalProperties": true
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "display": {
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": true,
      "anyOf": [
        {
          "required": [
            "sourceId",
            "targetId",
            "edgeType",
            "propertyMap"
          ]
        },
        {
          "required": [
            "id"
          ]
        }
      ]
    },
    "PropertyEnumValue": {
      "type": "object",
      "description": "Property 的 OMS EnumType 全量枚举项；isDefault 按用户示例采用字符串 true/false（非 JSON Boolean），description/synonyms 缺失时可省略，字段不得由 LLM 或索引猜测。",
      "required": [
        "value",
        "isDefault",
        "defaultDataValue"
      ],
      "properties": {
        "value": {
          "type": "string",
          "description": "OMS 枚举规范 value"
        },
        "isDefault": {
          "type": "string",
          "enum": [
            "true",
            "false"
          ],
          "description": "枚举是否默认值，字符串形式，与提供的接口样例严格一致"
        },
        "defaultDataValue": {
          "type": "string",
          "description": "默认物理值，比如 0/1/2 的字符串表示，由 OMS 提供"
        },
        "description": {
          "type": "object",
          "description": "OMS 多语言描述；可缺省",
          "properties": {
            "en": {
              "type": "string"
            },
            "zh": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "synonyms": {
          "type": "object",
          "description": "OMS 多语言同义词数组；可缺省",
          "properties": {
            "en": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "zh": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "PropertyInstanceValue": {
      "type": "object",
      "description": "仅来自 t_oag_instance_{ontology_id} 的有效实例值匹配，保留输入 sourceValue 和标准 canonicalValue，不附加枚举 defaultDataValue。",
      "required": [
        "sourceValue",
        "canonicalValue"
      ],
      "properties": {
        "sourceValue": {
          "type": "string"
        },
        "canonicalValue": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
