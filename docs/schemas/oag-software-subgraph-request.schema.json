{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cfwl100/onology_dsl/blob/main/docs/schemas/oag-software-subgraph-request.schema.json",
  "title": "OAG 统一 V2 语义子图检索请求（query/entities 双模式）",
  "description": "正式 V2 路径：POST /v2/onto-retrieval/subgraph/semantic-search。ontologyId Body 必填。query 与 entities 至少一个有效非空，同时存在时优先 entities。正式接口声明 entities 为 JSON String（1～102400 字符），已有 CBS 示例是 Object：两种传输形态并列供联调，不意味着后端实际均支持。接口文档使用 topk，原内部 Skill 脚本使用 topK，须迁移适配。",
  "type": "object",
  "required": [
    "ontologyId"
  ],
  "properties": {
    "ontologyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "V2 Body 本体 ID 必填；V1 中 ontologyId 是 Path 参数。"
    },
    "query": {
      "type": "string",
      "maxLength": 1024,
      "description": "自然语言查询：有效非空时触发 V1 能力继承模式；与 entities 至少一个有效非空。"
    },
    "entities": {
      "description": "V2 结构化实体：正式参数表为 JSON String（1～102400 字符），CBS 示例为 JSON Object；传输支持范围必须以实际 Controller/DTO 联调为准。双输入均有效时优先 entities。",
      "oneOf": [
        {
          "$ref": "#/$defs/Entities"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 102400,
          "contentMediaType": "application/json",
          "description": "JSON 序列化实体结构，必须由服务端额外解析及验证业务结构；JSON Schema contentMediaType 仅注释，不保证可解析。"
        }
      ]
    },
    "adaptiveRetrieval": {
      "type": "integer",
      "enum": [
        0,
        1
      ],
      "default": 1,
      "description": "V2 默认 1；当本体 ObjectType+Property 数 <=300 时默认全量返回，超过阈值按策略；CBS entities 可传 0。"
    },
    "seedRetrievalMode": {
      "type": "string",
      "enum": [
        "vector",
        "keyword",
        "hybrid"
      ],
      "default": "vector"
    },
    "similarityThreshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.6,
      "description": "vector/hybrid 模式匹配阈值。"
    },
    "topk": {
      "type": "integer",
      "minimum": 1,
      "default": 3,
      "description": "正式 V2 参数表使用 topk 小写，原 Skill 的 topK 要由迁移代码明确转换，不默认服务端支持别名。"
    },
    "graphExpansionStrategy": {
      "type": "string",
      "enum": [
        "minimal",
        "khop",
        "component"
      ],
      "default": "minimal"
    },
    "hopLimit": {
      "type": "integer",
      "minimum": 1,
      "default": 3,
      "description": "V2 正式表规定 khop 时控制图外扩深度。"
    },
    "includeFunctions": {
      "type": "integer",
      "enum": [
        0,
        1
      ],
      "default": 0,
      "description": "继承 V1 Function 能力。"
    },
    "includeActions": {
      "type": "integer",
      "enum": [
        0,
        1
      ],
      "default": 0,
      "description": "继承 V1 Action 能力。"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "Entities": {
      "type": "object",
      "description": "entities 的业务 JSON 结构，允许 extractedEntities 与 propertyValues 中至少一项非空；用于软件对象示例及对 JSON String 解码后业务结构的服务端校验。",
      "properties": {
        "extractedEntities": {
          "type": "array",
          "description": "业务侧已与 OMS 本体定义对齐的 ObjectType / Property 显式锚点；可省略。",
          "items": {
            "$ref": "#/$defs/ExtractedEntity"
          }
        },
        "propertyValues": {
          "type": "array",
          "description": "携带冗余可能的值候选，按对象分组；可省略。",
          "items": {
            "$ref": "#/$defs/PropertyValueGroup"
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "extractedEntities"
          ],
          "properties": {
            "extractedEntities": {
              "minItems": 1
            }
          }
        },
        {
          "required": [
            "propertyValues"
          ],
          "properties": {
            "propertyValues": {
              "minItems": 1
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "ExtractedEntity": {
      "type": "object",
      "description": "显式对象/属性种子。",
      "properties": {
        "objectType": {
          "type": "string",
          "description": "本体对象类型规范名称。",
          "minLength": 1
        },
        "properties": {
          "type": "array",
          "description": "已对齐的属性列表；输入可只提供 objectType。",
          "items": {
            "type": "string",
            "description": "真实属性名称。",
            "minLength": 1
          }
        }
      },
      "required": [
        "objectType"
      ],
      "additionalProperties": true
    },
    "PropertyValueGroup": {
      "type": "object",
      "description": "值候选按 ObjectType 分组。",
      "properties": {
        "objectType": {
          "type": "string",
          "description": "属性值所属对象类型规范名称。",
          "minLength": 1
        },
        "propertyValues": {
          "type": "array",
          "description": "当前对象下的一个或多个待链接属性值。",
          "items": {
            "$ref": "#/$defs/PropertyValue"
          },
          "minItems": 1
        }
      },
      "required": [
        "objectType",
        "propertyValues"
      ],
      "additionalProperties": true
    },
    "PropertyValue": {
      "type": "object",
      "description": "单个属性值候选。",
      "properties": {
        "property": {
          "type": "string",
          "description": "可为空串：附件用 property=\"\" 表示属性未知的 value-only 候选，不等于已解析出属性。"
        },
        "value": {
          "type": "string",
          "description": "业务待标准化的原始值。",
          "minLength": 1
        }
      },
      "required": [
        "property",
        "value"
      ],
      "additionalProperties": true
    }
  },
  "anyOf": [
    {
      "required": [
        "query"
      ],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    {
      "required": [
        "entities"
      ],
      "properties": {
        "entities": {
          "oneOf": [
            {
              "$ref": "#/$defs/Entities"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 102400
            }
          ]
        }
      }
    }
  ]
}
