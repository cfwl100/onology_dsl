{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cfwl100/onology_dsl/blob/main/docs/schemas/oag-software-subgraph-request.schema.json",
  "title": "OAG V2 请求 JSON Schema（按最新接口附件）",
  "description": "POST /v2/onto-retrieval/subgraph/semantic-search；ontologyId 在 Body。query/entities 至少一个非空，entities 非空优先；HTTP entities 是 JSON String，内容须包含 {entities:{extractedEntities:[...],propertyValues:[...]}}。",
  "type": "object",
  "required": [
    "ontologyId"
  ],
  "properties": {
    "ontologyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "V2 Body 本体 ID 必填；V1 中 ontologyId 是 Path 参数。"
    },
    "query": {
      "type": "string",
      "maxLength": 1024,
      "description": "自然语言查询：有效非空时触发 V1 能力继承模式；与 entities 至少一个有效非空。"
    },
    "entities": {
      "type": "string",
      "minLength": 1,
      "maxLength": 102400,
      "contentMediaType": "application/json",
      "description": "实际 HTTP 类型为 String。字符串解码后必须校验本 schema 的 $defs.Entities；业务侧不得直接传 JSON Object。"
    },
    "adaptiveRetrieval": {
      "type": "integer",
      "enum": [
        0,
        1
      ],
      "default": 1,
      "description": "V2 默认 1；当本体 ObjectType+Property 数 <=300 时默认全量返回，超过阈值按策略；CBS entities 可传 0。"
    },
    "seedRetrievalMode": {
      "type": "string",
      "enum": [
        "vector",
        "keyword",
        "hybrid"
      ],
      "default": "vector"
    },
    "similarityThreshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.6,
      "description": "vector/hybrid 模式匹配阈值。"
    },
    "topk": {
      "type": "integer",
      "minimum": 1,
      "default": 3,
      "description": "正式 V2 参数表使用 topk 小写，原 Skill 的 topK 要由迁移代码明确转换，不默认服务端支持别名。"
    },
    "graphExpansionStrategy": {
      "type": "string",
      "enum": [
        "minimal",
        "khop",
        "component"
      ],
      "default": "minimal"
    },
    "hopLimit": {
      "type": "integer",
      "minimum": 1,
      "default": 3,
      "description": "V2 正式表规定 khop 时控制图外扩深度。"
    },
    "includeFunctions": {
      "type": "integer",
      "enum": [
        0,
        1
      ],
      "default": 0,
      "description": "继承 V1 Function 能力。"
    },
    "includeActions": {
      "type": "integer",
      "enum": [
        0,
        1
      ],
      "default": 0,
      "description": "继承 V1 Action 能力。"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "Entities": {
      "type": "object",
      "description": "HTTP entities 内层结构，extractedEntities 至少有一个对象；其 properties 可省略，propertyValues 可省略。",
      "properties": {
        "extractedEntities": {
          "type": "array",
          "description": "业务侧已与 OMS 本体定义对齐的 ObjectType / Property 显式锚点；可省略。",
          "items": {
            "$ref": "#/$defs/ExtractedEntity"
          },
          "minItems": 1
        },
        "propertyValues": {
          "type": "array",
          "description": "携带冗余可能的值候选，按对象分组；可省略。",
          "items": {
            "$ref": "#/$defs/PropertyValueGroup"
          }
        }
      },
      "additionalProperties": true,
      "required": [
        "extractedEntities"
      ]
    },
    "ExtractedEntity": {
      "type": "object",
      "description": "显式对象/属性种子。",
      "properties": {
        "objectType": {
          "type": "string",
          "description": "本体对象类型规范名称。",
          "minLength": 1
        },
        "properties": {
          "type": "array",
          "description": "已对齐的属性列表；输入可只提供 objectType。",
          "items": {
            "type": "string",
            "description": "真实属性名称。",
            "minLength": 1
          }
        }
      },
      "required": [
        "objectType"
      ],
      "additionalProperties": true
    },
    "PropertyValueGroup": {
      "type": "object",
      "description": "值候选按 ObjectType 分组。",
      "properties": {
        "objectType": {
          "type": "string",
          "description": "属性值所属对象类型规范名称。",
          "minLength": 1
        },
        "propertyValues": {
          "type": "array",
          "description": "当前对象下的一个或多个待链接属性值。",
          "items": {
            "$ref": "#/$defs/PropertyValue"
          },
          "minItems": 1
        }
      },
      "required": [
        "objectType",
        "propertyValues"
      ],
      "additionalProperties": true
    },
    "PropertyValue": {
      "type": "object",
      "description": "单个属性值候选。",
      "properties": {
        "property": {
          "type": "string",
          "description": "可省略或空串，均表示不指定 Property、在 objectType 的可检索语义字段做值链接"
        },
        "value": {
          "type": "string",
          "description": "业务待标准化的原始值。",
          "minLength": 1
        }
      },
      "required": [
        "value"
      ],
      "additionalProperties": true
    }
  },
  "anyOf": [
    {
      "required": [
        "query"
      ],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    {
      "required": [
        "entities"
      ],
      "properties": {
        "entities": {
          "type": "string",
          "minLength": 1,
          "maxLength": 102400
        }
      }
    }
  ]
}
