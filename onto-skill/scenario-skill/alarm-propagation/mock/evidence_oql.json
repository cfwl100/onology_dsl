{
  "version": "1.0",
  "schemaRef": "network@1.0",
  "strict": true,
  "operation": "ASSOCIATION_QUERY",
  "objects": [
    {"objectType": "Ne", "alias": "ne_start"},
    {"objectType": "Site", "alias": "site"},
    {"objectType": "Ne", "alias": "ne_same_site"},
    {"objectType": "Alarm", "alias": "alarm"}
  ],
  "relationships": [
    {"relationshipType": "containsBy", "alias": "r1", "from": "ne_start", "to": "site"},
    {"relationshipType": "contain", "alias": "r2", "from": "site", "to": "ne_same_site"},
    {"relationshipType": "happenOn", "alias": "r3", "from": "alarm", "to": "ne_same_site"}
  ],
  "conditions": {
    "kind": "GROUP",
    "relation": "AND",
    "children": [
      {"kind": "PREDICATE", "ref": "ne_start", "field": "name", "operator": "EQ", "values": ["DLE_AIRHITAM_GEBANG_MT"]},
      {"kind": "PREDICATE", "ref": "alarm", "field": "alarmName", "operator": "IN", "values": ["CXU External Power Supply Insufficient", "Mains Failure", "POWER_ABNORMAL", "The main power supply abnormal", "Base Station DC Power Supply Abnormal", "Power Failure", "The voltage of The power supply is abnormal", "ShutDownNotify", "PLUG-IN UNIT POWER FAILURE", "Low Input Voltage", "Power Invalid", "POWER UNIT FAILURE", "Power Disturbance", "RHUB PSE Power Supply Failure", "Input voltage is out of The configured range", "Input Power Failure", "Power Supply", "Board Powered Off", "Genset Running", "Power Supply DC Output Out of Range", "RPU powered off", "POWER SUPPLY FAILURE", "Power Supply Failure", "Rectifier Failed", "POWER_ALM"]}
    ]
  },
  "returns": [
    {"kind": "FIELDS", "ref": "ne_start", "fields": ["name", "srcSpaceVid", "className", "domain", "networkType"]},
    {"kind": "FIELDS", "ref": "site", "fields": ["name"]},
    {"kind": "FIELDS", "ref": "ne_same_site", "fields": ["name", "className", "domain", "networkType"]},
    {"kind": "FIELDS", "ref": "alarm", "fields": ["node", "ownerVid", "severity", "alarmName", "identifier", "firstOccurrence", "lastOccurrence", "clearTime"]}
  ],
  "maxResults": 1000
}