若环境恢复，按以下 OQL 执行：
{
  "version": "1.0",
  "schemaRef": "network@1.0",
  "operation": "ASSOCIATION_QUERY",
  "objects": [
    {"objectType": "Ne", "alias": "ne_start"},
    {"objectType": "Site", "alias": "site"},
    {"objectType": "Ne", "alias": "ne_other"},
    {"objectType": "Alarm", "alias": "alarm"}
  ],
  "relationships": [
    {"relationshipType": "containsBy", "alias": "r1", "from": "ne_start", "to": "site"},
    {"relationshipType": "contain", "alias": "r2", "from": "site", "to": "ne_other"},
    {"relationshipType": "happenOn", "alias": "r3", "from": "alarm", "to": "ne_other", "direction": "reverse"}
  ],
  "conditions": {
    "kind": "PREDICATE",
    "ref": "ne_start",
    "field": "name",
    "operator": "EQ",
    "values": ["DLE_AIRHITAM_GEBANG_MT"]
  },
  "returns": [
    {"kind": "FIELDS", "ref": "ne_start", "fields": ["srcSpaceVid", "name", "className", "domain", "networkType"]},
    {"kind": "FIELDS", "ref": "ne_other", "fields": ["srcSpaceVid", "name", "className", "domain", "networkType"]},
    {"kind": "FIELDS", "ref": "alarm", "fields": ["node", "ownerVid", "severity", "alarmName", "identifier", "firstOccurrence", "lastOccurrence", "clearTime"]}
  ],
  "maxResults": 1000
}
