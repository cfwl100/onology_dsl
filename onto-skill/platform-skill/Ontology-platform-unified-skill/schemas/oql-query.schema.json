{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cfwl100.github.io/onology_dsl/schemas/oql-query.schema.json",
  "title": "OQL QUERY JSON Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "schemaRef",
    "operation",
    "objects",
    "returns"
  ],
  "properties": {
    "version": {
      "const": "1.0"
    },
    "schemaRef": {
      "type": "string",
      "minLength": 1
    },
    "strict": {
      "type": "boolean",
      "default": true
    },
    "conditions": {
      "$ref": "#/definitions/condition"
    },
    "orders": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/order"
      },
      "minItems": 1
    },
    "maxResults": {
      "$ref": "#/definitions/maxResults"
    },
    "sourceQuery": {
      "$ref": "#/definitions/sourceQuery"
    },
    "options": {
      "$ref": "#/definitions/options"
    },
    "extensions": {
      "$ref": "#/definitions/extensions"
    },
    "operation": {
      "const": "QUERY"
    },
    "objects": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/object"
      },
      "minItems": 1
    },
    "returns": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/definitions/fieldsReturn"
          },
          {
            "$ref": "#/definitions/exprReturn"
          },
          {
            "$ref": "#/definitions/idNameReturn"
          }
        ]
      },
      "minItems": 1
    }
  },
  "definitions": {
    "alias": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "field": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          {
            "const": "*"
          },
          {
            "pattern": "^(ID|NAME)\\("
          }
        ]
      }
    },
    "idNameField": {
      "type": "string",
      "pattern": "^(ID|NAME)\\([A-Za-z_][A-Za-z0-9_]*\\)$",
      "description": "仅允许大写 ID(fieldName) 或 NAME(fieldName)。"
    },
    "value": {
      "type": [
        "string",
        "number",
        "integer",
        "boolean"
      ]
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objectType",
        "alias"
      ],
      "properties": {
        "objectType": {
          "type": "string",
          "minLength": 1
        },
        "alias": {
          "$ref": "#/definitions/alias"
        },
        "fromSource": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "fieldExpr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref",
        "field"
      ],
      "properties": {
        "kind": {
          "const": "FIELD"
        },
        "ref": {
          "$ref": "#/definitions/alias"
        },
        "field": {
          "$ref": "#/definitions/field"
        }
      }
    },
    "valueExpr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "VALUE"
        },
        "value": {}
      }
    },
    "functionExpr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "args"
      ],
      "properties": {
        "kind": {
          "const": "FUNCTION"
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "not": {
            "enum": [
              "ID",
              "NAME",
              "id",
              "name"
            ]
          }
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/expr"
          }
        }
      }
    },
    "expr": {
      "oneOf": [
        {
          "$ref": "#/definitions/fieldExpr"
        },
        {
          "$ref": "#/definitions/valueExpr"
        },
        {
          "$ref": "#/definitions/functionExpr"
        }
      ]
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "operator"
      ],
      "oneOf": [
        {
          "required": [
            "ref",
            "field"
          ]
        },
        {
          "required": [
            "left"
          ]
        }
      ],
      "properties": {
        "kind": {
          "const": "PREDICATE"
        },
        "ref": {
          "$ref": "#/definitions/alias"
        },
        "field": {
          "$ref": "#/definitions/field"
        },
        "left": {
          "$ref": "#/definitions/expr"
        },
        "operator": {
          "enum": [
            "EQ",
            "NE",
            "GT",
            "GTE",
            "LT",
            "LTE",
            "IN",
            "NOT_IN",
            "BETWEEN",
            "LIKE",
            "CONTAINS",
            "STARTS_WITH",
            "ENDS_WITH",
            "IS_NULL",
            "IS_NOT_NULL",
            "IS_EMPTY",
            "IS_NOT_EMPTY",
            "EXISTS",
            "NOT_EXISTS"
          ]
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/value"
          }
        },
        "subquery": {
          "type": "object"
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "relation",
        "children"
      ],
      "properties": {
        "kind": {
          "const": "GROUP"
        },
        "relation": {
          "enum": [
            "AND",
            "OR",
            "NOT"
          ]
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/condition"
          },
          "minItems": 1
        }
      }
    },
    "condition": {
      "oneOf": [
        {
          "$ref": "#/definitions/predicate"
        },
        {
          "$ref": "#/definitions/group"
        }
      ]
    },
    "fieldsReturn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref",
        "fields"
      ],
      "properties": {
        "kind": {
          "const": "FIELDS"
        },
        "ref": {
          "$ref": "#/definitions/alias"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/field"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "exprReturn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "expr",
        "alias"
      ],
      "properties": {
        "kind": {
          "const": "EXPR"
        },
        "expr": {
          "$ref": "#/definitions/expr"
        },
        "alias": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "idNameReturn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref",
        "field",
        "alias"
      ],
      "properties": {
        "kind": {
          "const": "FUNCTION"
        },
        "ref": {
          "$ref": "#/definitions/alias"
        },
        "field": {
          "$ref": "#/definitions/idNameField"
        },
        "alias": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "order": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "direction"
      ],
      "properties": {
        "ref": {
          "$ref": "#/definitions/alias"
        },
        "field": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "^(ID|NAME)\\("
          }
        },
        "direction": {
          "enum": [
            "ASC",
            "DESC"
          ]
        }
      }
    },
    "maxResults": {
      "type": "integer",
      "minimum": 1,
      "description": "最大返回条数，必须使用数字格式，例如 maxResults: 1000。"
    },
    "sourceQuery": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "outputAs"
        ],
        "properties": {
          "outputAs": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": true
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  }
}